<?xml version="1.0" encoding="utf-8"?><!--
   Regras de backup. O domínio "database" é excluído para que, ao desinstalar
   e reinstalar o app, o banco não seja restaurado pelo Android (restore automático).
   Assim a reinstalação sempre começa com dados limpos.
   Ver: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Exclui o banco Room: não será restaurado na reinstalação -->
    <exclude domain="database" path="." />
</full-backup-content>